{
  "name": "black-code",
  "icon": "media/logo.png",
  "displayName": "Black Code",
  "description": "Premium Offline AI Coding Assistant",
  "publisher": "Anoneurx",
  "author": "Anoneurx",
  "version": "1.2.0",

  "license": "Apache-2.0",
  "categories": [

    "Programming Languages",
    "Snippets",
    "Machine Learning",
    "Education"
  ],
  "keywords": [
    "ai",
    "copilot",
    "offline",
    "llama",
    "rust",
    "blackcode",
    "qwen"
  ],
  "engines": {
    "vscode": "^1.70.0",
    "node": ">=20.20.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anoneurx/blackcode.git"
  },
  "activationEvents": [

    "onUri",
    "onStartupFinished",
    "onView:blackcode.blackcodeGUIView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Black Code",
      "properties": {
        "blackcode.model": {
          "type": "string",
          "default": "Black Code Beta Default",
          "enum": [
            "Black Code Beta Default",
            "Black Code Pro",
            "Black Code Lite"
          ],
          "description": "Select the active AI model."
        },
        "blackcode.betaPath": {
          "type": "string",
          "default": "models/qwen2.5-coder-7b-instruct.gguf",
          "description": "Path to the Black Code Beta Default model file."
        },
        "blackcode.proPath": {
          "type": "string",
          "default": "models/qwen2.5-coder-7b-pro.gguf",
          "description": "Path to the Black Code Pro model file."
        },
        "blackcode.litePath": {
          "type": "string",
          "default": "models/qwen2.5-coder-0.5b-lite.gguf",
          "description": "Path to the Black Code Lite model file."
        },
        "blackcode.backendUrl": {
          "type": "string",
          "default": "ws://127.0.0.1:7777",
          "description": "URL of the Black Code backend server."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "blackcode",
          "title": "Black Code",
          "icon": "media/logo.png"
        }
      ]
    },
    "views": {
      "blackcode": [
        {
          "type": "webview",
          "id": "blackcode.blackcodeGUIView",
          "name": "Black Code",
          "icon": "media/logo.png",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "blackcode.applyCode",
        "title": "Apply Code Patch"
      }
    ]
  },
  "scripts": {
    "compile": "npm run esbuild && npm run esbuild:webview",
    "esbuild": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node",
    "esbuild:webview": "esbuild src/webview/main.ts --bundle --outfile=webview/webview.js --platform=browser --format=iife --loader:.ttf=dataurl --loader:.woff=dataurl --loader:.woff2=dataurl",
    "watch": "npm run esbuild -- --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "1.6.4",
    "@nestjs/common": "^11.0.16",
    "@openapitools/openapi-generator-cli": "^2.23.1",
    "@types/chai": "^5.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/follow-redirects": "^1.14.4",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.18.126",
    "@types/node-fetch": "^2.6.12",
    "@types/react-dom": "^18.2.4",
    "@types/request": "^2.48.8",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "1.70",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@vscode/vsce": "^2.22.0",
    "cargo-cp-artifact": "^0.1",
    "chai": "^4.5.0",
    "esbuild": "^0.25.0",
    "esbuild-visualizer": "^0.6.0",
    "eslint": "^8.28.0",
    "json-schema-to-typescript": "^12.0.0",
    "ovsx": "^0.8.3",
    "rimraf": "^5.0.5",
    "typescript": "^5.6.3",
    "vite": "^4.5.14",
    "vscode-extension-tester": "^8.14.1"
  },
  "dependencies": {
    "@continuedev/config-types": "file:../packages/config-types",
    "@continuedev/fetch": "file:../packages/fetch",
    "@electron/rebuild": "^4.0.3",
    "@reduxjs/toolkit": "^1.9.3",
    "@vscode/ripgrep": "^1.15.9",
    "axios": "^1.13.1",
    "core": "file:../core",
    "cors": "^2.8.5",
    "dbinfoz": "^0.14.0",
    "diff": "^8.0.4",
    "dompurify": "^3.4.4",
    "downshift": "^7.6.0",
    "express": "^4.18.2",
    "fkill": "^8.1.0",
    "follow-redirects": "^1.15.4",
    "handlebars": "^4.7.8",
    "highlight.js": "^11.11.1",
    "highlightable": "^1.3.0-beta.0",
    "http-proxy": "^1.18.1",
    "http-proxy-agent": "^7.0.0",
    "http-proxy-middleware": "^2.0.9",
    "https-proxy-agent": "^7.0.2",
    "ignore": "^5.3.0",
    "jsdom": "^24.0.0",
    "katex": "^0.16.47",
    "lru-cache": "^11.2.4",
    "markdown-it": "^14.1.1",
    "markdown-it-katex": "^2.0.3",
    "minisearch": "^7.0.0",
    "mocha": "^11.7.5",
    "monaco-editor": "^0.53.0",
    "monaco-vscode-textmate-theme-converter": "^0.1.7",
    "ncp": "^2.0.0",
    "node-fetch": "^3.3.2",
    "node-machine-id": "^1.1.12",
    "posthog-node": "^3.6.3",
    "react-markdown": "^8.0.7",
    "react-redux": "^8.0.5",
    "read-last-lines": "^1.8.0",
    "socket.io-client": "^4.7.2",
    "strip-ansi": "^7.1.0",
    "svg-builder": "^2.0.0",
    "systeminformation": "^5.30.8",
    "tailwindcss": "^3.3.2",
    "undici": "^6.24.0",
    "uuid": "^9.0.1",
    "uuidv4": "^6.2.13",
    "vectordb": "0.4.20",
    "vitest": "^3.1.4",
    "vscode-languageclient": "^8.0.2",
    "ws": "^8.19.0",
    "yarn": "^1.22.21"
  }
}
